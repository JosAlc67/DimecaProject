<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>irb2600_coating_cell</name>
  <version>0.1.0</version>
  <description>
    Simulated coating cell for the DIMECA digital prototype: static
    target-structure/obstacle planning-scene setup, simulated RGB-D
    perception, and the spray_on logical control signal (Progress Report 1,
    Sec. VI-VIII).
  </description>
  <maintainer email="manuel.alcivar12@gmail.com">DIMECA Group 1</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>action_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>irb2600_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
